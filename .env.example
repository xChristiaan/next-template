# Domain für Plausible Analytics (z. B. plausible.aaa.de)
PLAUSIBLE_DOMAIN=

# Öffentlich: Basis-URL der Website
NEXT_PUBLIC_SITE_URL=https://aaa.example

# Öffentlich: Feature-Toggles oder Tracking-Freigaben
NEXT_PUBLIC_ENABLE_PLAUSIBLE=false

# Backend: Plausible API-Key (falls benötigt)
PLAUSIBLE_API_KEY=
