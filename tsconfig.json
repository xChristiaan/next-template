{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "framer-motion": ["./lib/stubs/framer-motion"],
      "next-seo": ["./lib/stubs/next-seo"],
      "zod": ["./lib/stubs/zod"],
      "contentlayer/source-files": ["./lib/stubs/contentlayer"],
      "next-contentlayer/hooks": ["./lib/stubs/next-contentlayer-hooks"],
      "contentlayer/generated": ["./lib/stubs/contentlayer-generated"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
